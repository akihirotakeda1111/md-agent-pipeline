{
  "task_spec": {
    "directory": "specs/tasks"
  },
  "state": {
    "directory": ".agent/state"
  },
  "codex": {
    "bin": "codex",
    "package": "@openai/codex",
    "version": "0.147.0",
    "model": "gpt-5.4-mini",
    "timeout_seconds": 1800,
    "sandbox": "workspace-write",
    "api_key_env": "CODEX_API_KEY",
    "ignore_user_config": true
  },
  "retry": {
    "repair_attempt_limit": 3,
    "review_attempt_limit": 3
  },
  "validation": {
    "timeout_seconds": 600,
    "require_clean_worktree": true
  },
  "review": {
    "provider": "openai",
    "classifier_model": "gpt-5.4-nano-2026-03-17",
    "confidence_threshold": 0.80,
    "auto_repair_enabled": false,
    "api_key_env": "REVIEW_CLASSIFIER_API_KEY",
    "track_author": "github-actions[bot]",
    "max_comments_per_run": null
  },
  "notification": {
    "enabled": false,
    "channel": null,
    "mention": null
  },
  "coderabbit": {
    "actor": "coderabbitai[bot]",
    "check_app_slug": "coderabbitai",
    "status_context": "CodeRabbit"
  },
  "runtime_edit_policy": {
    "protected_paths": [
      "specs/**",
      ".agent/**",
      "agent/**",
      ".github/**"
    ]
  }
}
